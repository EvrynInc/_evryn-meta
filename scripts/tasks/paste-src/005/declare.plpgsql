  -- Change set 005 — declarations shared by its before- and after-assertions (one DO block = one set of variables).
  v_found        text;
  v_n            integer;
  v_i            integer;
  -- "NOTHING ELSE CHANGED": each query below is run BEFORE the migration and again AFTER it, with the very
  -- same text, and the two results must be identical. Each one deliberately EXCLUDES exactly what 005
  -- changes (the note columns, the five constraints it adds or replaces, the bodies of the two functions it
  -- replaces), so everything else on tasks, task_history and proposals, and on every task function, is held
  -- still. They run under search_path '' (set first thing in before.plpgsql).
  v_capture_names text[] := array[
    'tables (owner, RLS)',
    'columns other than note',
    'constraints other than the five 005 adds or replaces',
    'indexes',
    'triggers (definition, ENABLE mode, and OID: not dropped or recreated)',
    'policies',
    'table grants',
    'identity sequences and their grants',
    'task functions 005 does not replace (incl. body hash)',
    'the two replaced functions: same object, owner, security, volatility, search_path',
    'EXECUTE privileges on every task function',
    'rows: no existing value changed, no history row written'];
  v_capture_sqls text[] := array[
    $q$ select string_agg(format('table %s: owner=%s rls=%s forced=%s', c.relname, pg_get_userbyid(c.relowner), c.relrowsecurity, c.relforcerowsecurity), E'\n' order by c.relname)
          from pg_class c where c.relnamespace = 'public'::regnamespace and c.relkind = 'r' and c.relname in ('tasks','task_history','proposals') $q$,
    $q$ select string_agg(format('column %s %s %s%s%s%s', c.relname, a.attname, format_type(a.atttypid, a.atttypmod),
                   case when a.attnotnull then ' NOT NULL' else '' end,
                   case a.attidentity when 'a' then ' IDENTITY ALWAYS' when 'd' then ' IDENTITY BY DEFAULT' else '' end,
                   case when a.attgenerated = 's' then ' GENERATED ' || pg_get_expr(d.adbin, d.adrelid)
                        when d.adbin is not null then ' DEFAULT ' || pg_get_expr(d.adbin, d.adrelid) else '' end), E'\n' order by c.relname, a.attnum)
          from pg_class c
          join pg_attribute a on a.attrelid = c.oid and a.attnum > 0 and not a.attisdropped
          left join pg_attrdef d on d.adrelid = c.oid and d.adnum = a.attnum
         where c.relnamespace = 'public'::regnamespace and c.relname in ('tasks','task_history','proposals') and a.attname <> 'note' $q$,
    $q$ select string_agg(format('constraint %s.%s: %s validated=%s', c.relname, con.conname, pg_get_constraintdef(con.oid), con.convalidated), E'\n' order by c.relname, con.conname)
          from pg_constraint con join pg_class c on c.oid = con.conrelid
         where c.relnamespace = 'public'::regnamespace and c.relname in ('tasks','task_history','proposals')
           and con.conname not in ('tasks_status_allowed','tasks_note_max_600','tasks_acceptance_addressed','tasks_backlog_needs_review_date','task_history_note_max_600') $q$,
    $q$ select string_agg(format('index %s.%s: %s', i.tablename, i.indexname, i.indexdef), E'\n' order by i.tablename, i.indexname)
          from pg_indexes i where i.schemaname = 'public' and i.tablename in ('tasks','task_history','proposals') $q$,
    $q$ select string_agg(format('trigger %s.%s: %s [enabled=%s] oid=%s', c.relname, t.tgname, pg_get_triggerdef(t.oid), t.tgenabled, t.oid), E'\n' order by c.relname, t.tgname)
          from pg_trigger t join pg_class c on c.oid = t.tgrelid
         where not t.tgisinternal and c.relnamespace = 'public'::regnamespace and c.relname in ('tasks','task_history','proposals') $q$,
    $q$ select string_agg(format('policy %s.%s: %s %s to %s using (%s) with check (%s)', p.tablename, p.policyname, p.permissive, p.cmd,
                   array_to_string(p.roles, ','), coalesce(p.qual, '-'), coalesce(p.with_check, '-')), E'\n' order by p.tablename, p.policyname)
          from pg_policies p where p.schemaname = 'public' and p.tablename in ('tasks','task_history','proposals') $q$,
    $q$ select string_agg(format('grant %s: %s %s%s', c.relname, coalesce(r.rolname, 'PUBLIC'), a.privilege_type,
                   case when a.is_grantable then ' WITH GRANT OPTION' else '' end), E'\n' order by c.relname, coalesce(r.rolname, 'PUBLIC'), a.privilege_type)
          from pg_class c
          cross join lateral aclexplode(coalesce(c.relacl, acldefault('r', c.relowner))) a
          left join pg_roles r on r.oid = a.grantee
         where c.relnamespace = 'public'::regnamespace and c.relkind = 'r' and c.relname in ('tasks','task_history','proposals') $q$,
    $q$ select string_agg(format('sequence %s.%s: owner=%s %s %s', c.relname, att.attname, pg_get_userbyid(sc.relowner), coalesce(r.rolname, 'PUBLIC'), a.privilege_type),
                   E'\n' order by c.relname, att.attname, coalesce(r.rolname, 'PUBLIC'), a.privilege_type)
          from pg_class c
          join pg_attribute att on att.attrelid = c.oid and att.attidentity <> '' and not att.attisdropped
          join pg_class sc on sc.oid = pg_get_serial_sequence(format('public.%I', c.relname), att.attname)::regclass
          cross join lateral aclexplode(coalesce(sc.relacl, acldefault('s', sc.relowner))) a
          left join pg_roles r on r.oid = a.grantee
         where c.relnamespace = 'public'::regnamespace and c.relname in ('tasks','task_history','proposals') $q$,
    $q$ select string_agg(format('function %s(%s): oid=%s owner=%s security=%s volatility=%s config=%s body_md5=%s', p.proname,
                   pg_get_function_identity_arguments(p.oid), p.oid, pg_get_userbyid(p.proowner), case when p.prosecdef then 'DEFINER' else 'INVOKER' end,
                   p.provolatile, coalesce(array_to_string(p.proconfig, ';'), '-'), md5(replace(p.prosrc, chr(13), ''))), E'\n' order by p.proname)
          from pg_proc p
         where p.pronamespace = 'public'::regnamespace
           and (p.proname like 'task\_%' or p.proname like 'tasks\_%' or p.proname = 'team_tasks_schema_snapshot')
           and p.proname not in ('tasks_before_write','tasks_after_write') $q$,
    $q$ select string_agg(format('function %s(%s): oid=%s owner=%s security=%s volatility=%s config=%s', p.proname,
                   pg_get_function_identity_arguments(p.oid), p.oid, pg_get_userbyid(p.proowner), case when p.prosecdef then 'DEFINER' else 'INVOKER' end,
                   p.provolatile, coalesce(array_to_string(p.proconfig, ';'), '-')), E'\n' order by p.proname)
          from pg_proc p
         where p.pronamespace = 'public'::regnamespace and p.proname in ('tasks_before_write','tasks_after_write') $q$,
    $q$ select string_agg(format('function-grant %s(%s): %s %s%s', p.proname, pg_get_function_identity_arguments(p.oid), coalesce(r.rolname, 'PUBLIC'), a.privilege_type,
                   case when a.is_grantable then ' WITH GRANT OPTION' else '' end), E'\n' order by p.proname, coalesce(r.rolname, 'PUBLIC'), a.privilege_type)
          from pg_proc p
          cross join lateral aclexplode(coalesce(p.proacl, acldefault('f', p.proowner))) a
          left join pg_roles r on r.oid = a.grantee
         where p.pronamespace = 'public'::regnamespace
           and (p.proname like 'task\_%' or p.proname like 'tasks\_%' or p.proname = 'team_tasks_schema_snapshot') $q$,
    $q$ select concat_ws(E'\n',
            (select format('tasks: %s rows, md5=%s', count(*), md5(coalesce(string_agg((to_jsonb(t) - 'note')::text, E'\n' order by t.id), ''))) from public.tasks t),
            (select format('task_history: %s rows, md5=%s', count(*), md5(coalesce(string_agg((to_jsonb(h) - 'note')::text, E'\n' order by h.id), ''))) from public.task_history h),
            (select format('proposals: %s rows, md5=%s', count(*), md5(coalesce(string_agg(to_jsonb(p)::text, E'\n' order by p.id), ''))) from public.proposals p)) $q$];
  v_captured     text[] := '{}';
  -- The PINS. One query per table renders exactly the lines public.team_tasks_schema_snapshot() prints
  -- (migration 004's own formats), so each expected value below is a verbatim copy of lines of the live
  -- snapshot taken over the API on 2026-11-06 ~09:57 PT, after Paste 2
  -- (evryn-team-workspace/shared/projects/helm/2026/2026.11.06-linear-cutover/2026.11.06-live-schema-snapshot-after-004.txt),
  -- which are identical to the same lines of test/fixtures/local-snapshot-after-004.txt.
  -- Every column of ONE table ($1), as `column <table> #NN <name> <type>[ NOT NULL][ IDENTITY …][ GENERATED …| DEFAULT …]`.
  v_pin_columns_sql text := $q$
    select string_agg(s.line, E'\n' order by s.attnum) from (
      select a.attnum,
             format('column %s #%s %s %s%s%s%s', c.relname,
               lpad(row_number() over (order by a.attnum)::text, 2, '0'), a.attname, format_type(a.atttypid, a.atttypmod),
               case when a.attnotnull then ' NOT NULL' else '' end,
               case a.attidentity when 'a' then ' IDENTITY ALWAYS' when 'd' then ' IDENTITY BY DEFAULT' else '' end,
               case when a.attgenerated = 's' then ' GENERATED ' || pg_get_expr(d.adbin, d.adrelid)
                    when d.adbin is not null then ' DEFAULT ' || pg_get_expr(d.adbin, d.adrelid) else '' end) as line
        from pg_class c
        join pg_attribute a on a.attrelid = c.oid and a.attnum > 0 and not a.attisdropped
        left join pg_attrdef d on d.adrelid = c.oid and d.adnum = a.attnum
       where c.relnamespace = 'public'::regnamespace and c.relname = $1) s
  $q$;
  -- Every constraint of ONE table ($1), as `constraint <table>.<name>: <definition>` (NOT VALID shows in the definition).
  v_pin_constraints_sql text := $q$
    select string_agg(format('constraint %s.%s: %s', c.relname, con.conname, pg_get_constraintdef(con.oid)), E'\n' order by con.conname)
      from pg_constraint con join pg_class c on c.oid = con.conrelid
     where c.relnamespace = 'public'::regnamespace and c.relname = $1
  $q$;
  -- The two functions 005 replaces, in migration 004's `function …` format (owner, security, volatility, search_path, body hash).
  v_pin_functions_sql text := $q$
    select string_agg(format('function %s(%s): owner=%s security=%s volatility=%s config=%s body_md5=%s',
             p.proname, pg_get_function_identity_arguments(p.oid), pg_get_userbyid(p.proowner),
             case when p.prosecdef then 'DEFINER' else 'INVOKER' end, p.provolatile,
             coalesce(array_to_string(p.proconfig, ';'), '-'), md5(replace(p.prosrc, chr(13), ''))), E'\n' order by p.proname)
      from pg_proc p
     where p.pronamespace = 'public'::regnamespace and p.proname in ('tasks_before_write','tasks_after_write')
  $q$;
